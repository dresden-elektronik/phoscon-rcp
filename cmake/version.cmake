# Writes the firmware's version into a header, on every build: VERSION at the repository root, as it
# stands on the commit tagged v<VERSION> and in a tree without git, otherwise with the commit it was
# built from (docs/build-and-flash.md §12). The header is rewritten only when the version changes.
#
#   cmake -DDS_REPO_DIR=<repository root> -DDS_VERSION_HEADER=<header> -P cmake/version.cmake
file(READ "${DS_REPO_DIR}/VERSION" _version)
string(STRIP "${_version}" _version)
set(_full "${_version}")

find_program(_git git)
if(_git)
  execute_process(COMMAND ${_git} -C "${DS_REPO_DIR}" rev-parse --show-toplevel
                  OUTPUT_VARIABLE _top OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  file(REAL_PATH "${DS_REPO_DIR}" _repo)
  # An unpacked archive inside some other repository is not that repository's commit.
  if(_top AND IS_DIRECTORY "${_top}")
    file(REAL_PATH "${_top}" _top)
  endif()
  if(_top STREQUAL _repo)
    execute_process(COMMAND ${_git} -C "${DS_REPO_DIR}" rev-parse --short=8 HEAD
                    OUTPUT_VARIABLE _commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND ${_git} -C "${DS_REPO_DIR}" status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE _dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND ${_git} -C "${DS_REPO_DIR}" tag --points-at HEAD --list "v${_version}"
                    OUTPUT_VARIABLE _tag OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_commit AND (_dirty OR NOT _tag))
      set(_full "${_version}+g${_commit}")
      if(_dirty)
        string(APPEND _full ".dirty")
      endif()
    endif()
  endif()
endif()

set(_text "/* Generated by cmake/version.cmake; do not edit. */\n#define PHOSCON_RCP_VERSION \"${_full}\"\n")
set(_old "")
if(EXISTS "${DS_VERSION_HEADER}")
  file(READ "${DS_VERSION_HEADER}" _old)
endif()
if(NOT _old STREQUAL _text)
  file(WRITE "${DS_VERSION_HEADER}" "${_text}")
endif()
